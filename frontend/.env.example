# Backend API endpoint (points to local FastAPI server for development)
VITE_BACKEND_URI=http://localhost:8000

# OpenWeatherMap API Key for local weather syncing and forecast updates
VITE_WEATHER_API_KEY=your_openweathermap_api_key_here

# Groq API Key for local voice assistant widget using Llama models
VITE_GROQ_API_KEY=your_groq_api_key_here
